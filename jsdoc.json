{
  "source": {
    "include": ["server.js"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(node_modules)"
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "readme": "./README.md"
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  }
}
